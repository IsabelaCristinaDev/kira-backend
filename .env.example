# Postgres local (usado pelo docker-compose.yml)
DB_USERNAME=kira_user
DB_PASSWORD=kira_pass
DB_NAME=kira_db

# Datasource da aplicacao (Spring)
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5433/kira_db
SPRING_DATASOURCE_USERNAME=kira_user
SPRING_DATASOURCE_PASSWORD=kira_pass

# JWT
JWT_SECRET=troque-por-uma-chave-secreta-forte
JWT_REFRESH_EXPIRATION=604800000

# E-mail (SMTP)
MAIL_USERNAME=seuemail@gmail.com
MAIL_PASSWORD=suasenha

# Servidor
SERVER_PORT=8081

# Mostra no log o SQL de cada consulta. Útil no local; no servidor, deixe desligado (padrão false)
# MOSTRAR_SQL=true

# Endereço do app web (link do e-mail de recuperação de senha)
FRONTEND_URL=http://localhost:5173

# Endereços do app web liberados no CORS e no WebSocket, separados por vírgula, com http:// ou https://.
# Opcional no local (o padrão são as portas de localhost 8080, 3000, 5173 e 4200)
# KIRA_CORS_ORIGENS=https://kira.exemplo.com

# Como achar o IP real atrás de um proxy: none (padrão, local), framework ou native. Ver "Diagnóstico de IP" no README
# FORWARD_HEADERS_STRATEGY=none
# TODO(LGPD): temporário. Registra no log os headers de IP do login, só para o diagnóstico do primeiro deploy
# REGISTRAR_HEADERS_IP=false

# Só no docker-compose.servidor.yml: onde a API fica exposta no servidor.
# O padrão 127.0.0.1:8081 deixa só o proxy com HTTPS acessar; 0.0.0.0:8081 abre para a rede
# API_ENDERECO=127.0.0.1:8081

# Lembrete de agendamento
LEMBRETE_ANTECEDENCIA_HORAS=24
LEMBRETE_CRON=0 0 * * * *
LEMBRETE_RETRY_MAX_TENTATIVAS=3
LEMBRETE_RETRY_DELAY_MS=2000
LEMBRETE_RETRY_MULTIPLICADOR=2

# SonarCloud
SONAR_TOKEN=

# Notificações do navegador (par de chaves próprio; a privada nunca vai para o repositório)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contato do responsável (https:// ou mailto:). Vazio usa o link do repositório
VAPID_SUBJECT=

# Provador virtual (Cloudflare Workers AI). O token nunca vai para o repositório
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Opcionais (os valores abaixo são os padrões)
# CLOUDFLARE_MODELO=@cf/black-forest-labs/flux-2-klein-4b
# CLOUDFLARE_TIMEOUT_LEITURA_MS=90000
# PROVADOR_VERSAO_CONSENTIMENTO=v1
# PROVADOR_TAMANHO_MAXIMO_BYTES=5242880
# PROVADOR_LIMITE_DIARIO=5

# IA de compatibilidade do Provador (kira-ai). Opcional: sem o serviço no ar, o app usa a própria ordem
# KIRA_AI_URL=http://localhost:8001

# Geocodificação pelo Nominatim (OpenStreetMap): não precisa de chave. Opcionais (os valores abaixo são os padrões)
# GEOCODIFICACAO_ATIVA=true
# GEOCODIFICACAO_USER_AGENT=KiraBackend/1.0 (TCC SENAI FATESG)
