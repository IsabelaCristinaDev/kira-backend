# Postgres local (usado pelo docker-compose.yml)
DB_USERNAME=kira_user
DB_PASSWORD=kira_pass
DB_NAME=kira_db

# Datasource da aplicacao (Spring)
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5433/kira_db
SPRING_DATASOURCE_USERNAME=kira_user
SPRING_DATASOURCE_PASSWORD=kira_pass

# JWT
JWT_SECRET=troque-por-uma-chave-secreta-forte
JWT_REFRESH_EXPIRATION=604800000

# E-mail (SMTP)
MAIL_USERNAME=seuemail@gmail.com
MAIL_PASSWORD=suasenha

# Servidor
SERVER_PORT=8081

# Endereço do app web (link do e-mail de recuperação de senha)
FRONTEND_URL=http://localhost:5173

# Lembrete de agendamento
LEMBRETE_ANTECEDENCIA_HORAS=24
LEMBRETE_CRON=0 0 * * * *
LEMBRETE_RETRY_MAX_TENTATIVAS=3
LEMBRETE_RETRY_DELAY_MS=2000
LEMBRETE_RETRY_MULTIPLICADOR=2

# SonarCloud
SONAR_TOKEN=
